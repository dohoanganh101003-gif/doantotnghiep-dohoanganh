<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Quản lý tài khoản</title>
    <link rel="stylesheet" href="/css/danhsach.css">
    <link rel="stylesheet" href="/css/quanlytaikhoan.css">
</head>

<body>
    <div class="header">
        <h2>Quản lý tài khoản</h2>

        <div>
            <a href="/" class="btn">Trang chủ</a>
            <a href="#modalOverlay" class="btn" onclick="openModal()">Thêm tài khoản</a>
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Hành động</th>
                </tr>
            </thead>

            <tbody>
                <% users.forEach(u=> { %>
                    <tr>
                        <td>
                            <%= u.id %>
                        </td>
                        <td>
                            <%= u.username %>
                        </td>
                        <td>
                            <%= u.email %>
                        </td>
                        <td>
                            <span class="role <%= u.role %>">
                                <%= u.role %>
                            </span>
                        </td>
                        <td>
                            <span class="status <%= u.status %>">
                                <%= u.status %>
                            </span>
                        </td>
                        <td>
                            <% if (u.status==="pending" ) { %>
                                <form action="/auth/admin/approve/<%= u.id %>" method="POST">
                                    <select name="role">
                                        <option value="user">User</option>
                                        <option value="owner">Owner</option>
                                    </select>
                                    <button class="action-btn btn-approve">Duyệt</button>
                                </form>
                                <form action="/auth/admin/delete/<%= u.id %>" method="POST">
                                    <button class="action-btn btn-delete">Xoá</button>
                                </form>
                                <% } else { %>
                                    <span style="color: #22c55e;">✔ Đã duyệt</span>
                                    <% } %>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>

    <div class="modal-overlay" id="modalOverlay" onclick="handleOverlayClick(event)">
        <div class="modal">
            <button class="modal-close" onclick="closeModal()">✕</button>
            <h3>Thêm tài khoản mới</h3>

            <div class="modal-form">
                <div class="field">
                    <label>Tên đăng nhập</label>
                    <input type="text" id="new-username" placeholder="Nhập username" />
                </div>
                <div class="field">
                    <label>Email</label>
                    <input type="email" id="new-email" placeholder="Nhập email" />
                </div>
                <div class="field">
                    <label>Số điện thoại</label>
                    <input type="text" id="new-phone" placeholder="Nhập số điện thoại" />
                </div>
                <div class="field">
                    <label>Mật khẩu</label>
                    <input type="password" id="new-password" placeholder="Nhập mật khẩu" />
                </div>
                <div class="field">
                    <label>Vai trò</label>
                    <select id="new-role">
                        <option value="user">User</option>
                        <option value="owner">Owner</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>

                <div class="modal-actions">
                    <button class="btn-cancel" onclick="closeModal()">Huỷ</button>
                    <button class="btn-submit" id="submitBtn" onclick="submitCreateUser()">Tạo tài khoản</button>
                </div>
            </div>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <script src="/scripts/quanlytaikhoan.js"></script>
</body>

</html>