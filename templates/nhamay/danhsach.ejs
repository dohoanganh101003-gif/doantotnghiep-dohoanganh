<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <title>Danh sách nhà máy</title>
    <link rel="stylesheet" href="/css/danhsach.css">
</head>

<body>

    <div class="header">
        <h2>Danh sách nhà máy</h2>

        <div>
            <a href="/" class="btn">Trang chủ</a>

            <% if (user && (user.role==="admin" || user.role==="owner" )) { %>
                <a href="/nhamay/them" class="btn">Thêm</a>
                <% } %>
        </div>

    </div>

    <div class="table-container">

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên nhà máy</th>
                    <th>Công suất</th>
                    <th>Trạng thái</th>
                    <th>Vĩ độ</th>
                    <th>Kinh độ</th>
                    <th>Hành động</th>
                </tr>
            </thead>

            <tbody>
                <% plants.forEach(p=> { %>
                    <tr>
                        <td>
                            <%= p.id %>
                        </td>
                        <td>
                            <%= p.ten_nha_may %>
                        </td>
                        <td>
                            <%= p.cong_suat %>
                        </td>
                        <td>
                            <%= p.trang_thai %>
                        </td>
                        <td>
                            <%= p.lat %>
                        </td>
                        <td>
                            <%= p.lng %>
                        </td>

                        <td>
                            <% if (user && (user.role==="admin" || user.id===p.owner_id)) { %>
                                <a href="/nhamay/sua/<%= p.id %>" class="action-btn btn-edit">Sửa</a>

                                <button class="action-btn btn-delete" onclick="xoa(<%= p.id %>)">
                                    Xoá
                                </button>
                                <% } else { %>
                                    <span style="color: gray;">Chỉ xem</span>
                                    <% } %>
                        </td>

                    </tr>
                    <% }) %>
            </tbody>
        </table>

    </div>


    <script src="/scripts/danhsach.js"></script>

</body>

</html>